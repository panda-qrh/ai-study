<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
    ⚠️ CRITICAL for MCP servers using StdioMcpServerTransport:
    StdioMcpServerTransport writes JSON-RPC to System.out.
    Logging MUST write to System.err to avoid corrupting the protocol stream.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- Reduce Spring Boot startup noise -->
    <logger name="org.springframework" level="ERROR"/>
    <logger name="org.apache" level="ERROR"/>
</configuration>
