package discount;
dialect "java"
//generated from Decision Table
import com.pojo.Order;
import com.pojo.Order2;
global java.util.List resultList;
function double calcuDiscount(double amount){if(amount>10000){return 0.6;}if(amount>5000){return 0.8;}if(amount>1000){return 0.9;} }
query "高额订单查询"(double min) $o:Order(amount>min) end
	salience 20
	no-loop true
	agenda-group "pricing"
// rule values at A17, header at A12
rule "大额订单"
/* 金额1万以上打6折 */
	salience 10
	when
		$o:Order(amount >= 10000, amount < 99999999)
	then
		$o.setDiscount(0.6);update($o);
end

// rule values at A18, header at A12
rule "中等订单"
/* 5千到1万打8折 */
	salience 9
	when
		$o:Order(amount >= 5000, amount < 10000)
	then
		$o.setDiscount(0.8);update($o);
end

// rule values at A19, header at A12
rule "小额订单"
/* 1千到5千打9折 */
	no-loop false
	agenda-group "low-pricing"
	when
		$o:Order(amount >= 1000, amount < 5000)
	then
		$o.setDiscount(0.9);update($o);
end
